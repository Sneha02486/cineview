{
  "name": "cineview-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run prisma:seed",
    "test:e2e": "npx playwright test",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "npm --prefix frontend install && npm --prefix frontend run build",
    "build": "npm run prisma:generate && npm run build:backend && npm run build:frontend"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
